# Example environment variables for X3 Alpha
# Copy this to `.env.local` for local testing (do NOT commit your real keys).

# Anthropic API key
ANTHROPIC_API_KEY=sk-...

# Upstash (Redis) REST endpoint and token
# Do NOT include surrounding quotes or a leading '=' — use the plain URL.
UPSTASH_REDIS_REST_URL=https://climbing-drake-40184.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Resend (email sending)
RESEND_API_KEY=live_...
EMAIL_FROM=X3 Alpha <onboarding@resend.dev>

# Stripe webhook signing secret (optional if you don't use Stripe locally)
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional
APP_URL=http://localhost:3000
FREE_DAILY_LIMIT=1
